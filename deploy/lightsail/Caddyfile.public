{
	admin 127.0.0.1:2019
	auto_https disable_redirects
	email {$REFUNDDESK_ACME_EMAIL}
	grace_period 30s
	http_port 8080
	https_port 8443
	persist_config off
	servers {
		timeouts {
			read_header 5s
			read_body 30s
			write 30s
			idle 60s
		}
		max_header_size 64KiB
	}
}

http://{$REFUNDDESK_PUBLIC_HOST}:8080 {
	redir https://{$REFUNDDESK_PUBLIC_HOST}{uri} 308
}

https://{$REFUNDDESK_PUBLIC_HOST}:8443 {
	encode zstd gzip

	header {
		-Server
		Cache-Control "no-store"
		X-RefundDesk-Revision "{$REFUNDDESK_REVISION}"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
	}

	route {
		@unverified_edge not header X-RefundDesk-Origin-Token {$REFUNDDESK_EDGE_ORIGIN_TOKEN}
		respond @unverified_edge 404

		@blocked path /internal /internal/* /api/ready /api/webhooks/stripe-connected /api/webhooks/stripe-connected/* /api/webhooks/stripe-account/live
		respond @blocked 404

		@signed_api path /api/v1/*
		request_body @signed_api {
			max_size 32768
		}

		@account_webhooks path /api/webhooks/stripe-account/test /api/webhooks/stripe-account/sandbox
		request_body @account_webhooks {
			max_size 1048576
		}

		# Freeze CloudFront's incoming chain before reverse_proxy rewrites XFF.
		vars refunddesk_cloudfront_viewer_chain "{http.request.header.X-Forwarded-For}"

		reverse_proxy web.refunddesk.internal:3000 {
			header_up X-RefundDesk-Viewer-Chain "{vars.refunddesk_cloudfront_viewer_chain}"
			header_up X-RefundDesk-Edge-Verified cloudfront-v1
			header_up -X-RefundDesk-Origin-Token
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
			}
		}
	}
}
