{
	admin 127.0.0.1:2019
	auto_https disable_redirects
	email {$REFUNDDESK_ACME_EMAIL}
	grace_period 30s
	http_port 8080
	https_port 8443
}

http://{$REFUNDDESK_PUBLIC_HOST}:8080 {
	redir https://{$REFUNDDESK_PUBLIC_HOST}{uri} 308
}

https://{$REFUNDDESK_PUBLIC_HOST}:8443 {
	encode zstd gzip

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
	}

	route {
		@blocked path /internal /internal/* /api/ready /api/webhooks/stripe-connected/live
		respond @blocked 404

		reverse_proxy web.refunddesk.internal:3000 {
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
			}
		}
	}
}
