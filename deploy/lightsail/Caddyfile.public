{
	admin 127.0.0.1:2019
	auto_https disable_redirects
	email {$REFUNDDESK_ACME_EMAIL}
	grace_period 30s
	http_port 8080
	https_port 8443
}

http://{$REFUNDDESK_PUBLIC_HOST}:8080 {
	redir https://{$REFUNDDESK_PUBLIC_HOST}{uri} 308
}

https://{$REFUNDDESK_PUBLIC_HOST}:8443 {
	encode zstd gzip

	header {
		-Server
		Cache-Control "no-store"
		X-RefundDesk-Revision "{$REFUNDDESK_REVISION}"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
	}

	route {
		@blocked path /internal /internal/* /api/ready /api/webhooks/stripe-connected /api/webhooks/stripe-connected/* /api/webhooks/stripe-account/live
		respond @blocked 404

		@signed_api path /api/v1/*
		request_body @signed_api {
			max_size 32768
		}

		@account_webhooks path /api/webhooks/stripe-account/test /api/webhooks/stripe-account/sandbox
		request_body @account_webhooks {
			max_size 1048576
		}

		reverse_proxy web.refunddesk.internal:3000 {
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
			}
		}
	}
}
