# Runtime
NODE_ENV=development
LOG_LEVEL=info
APP_BASE_URL=http://localhost:3000
REFUNDDESK_GLOBAL_LIVE_ENABLED=false

# PostgreSQL (fixed local-only Docker credentials; never reuse outside loopback)
DATABASE_URL=postgresql://refunddesk_web_login:refunddesk_web_local@127.0.0.1:5432/refunddesk
WORKER_DATABASE_URL=postgresql://refunddesk_worker_login:refunddesk_worker_local@127.0.0.1:5432/refunddesk
DATABASE_MIGRATION_URL=postgresql://refunddesk_owner:refunddesk_owner_local@127.0.0.1:5432/refunddesk
PGBOSS_DATABASE_URL=postgresql://refunddesk_worker_login:refunddesk_worker_local@127.0.0.1:5432/refunddesk

# Stripe App. Insert real values only in an ignored .env.local file.
STRIPE_API_VERSION=2026-06-24.dahlia
STRIPE_APP_SIGNING_SECRET=replace_me
STRIPE_PLATFORM_TEST_KEY=replace_me
STRIPE_MANAGED_SANDBOX_KEY=replace_me
STRIPE_CONNECTED_TEST_WEBHOOK_SECRET=replace_me
STRIPE_CONNECTED_SANDBOX_WEBHOOK_SECRET=replace_me
STRIPE_CONNECTED_LIVE_WEBHOOK_SECRET=disabled

# Independent, versioned application keys. Generate at least 32 random bytes.
REFUNDDESK_FIELD_ENCRYPTION_KEY_V1=replace_with_base64_32_bytes
REFUNDDESK_PROOF_HMAC_KEY_V1=replace_with_base64_32_bytes
REFUNDDESK_EXPORT_SIGNING_KEY_V1=replace_with_distinct_base64_32_bytes
REFUNDDESK_ACTIVE_FIELD_KEY_VERSION=v1
REFUNDDESK_ACTIVE_PROOF_KEY_VERSION=v1
