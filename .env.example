# Common runtime interlock
NODE_ENV=development
LOG_LEVEL=info
REFUNDDESK_GLOBAL_LIVE_ENABLED=false
STRIPE_API_VERSION=2026-06-24.dahlia
REFUNDDESK_SIGNED_REQUEST_VERIFIER_TOKEN=replace_with_shared_base64_32_bytes

# Platform process. Hosted environments inject only this section plus common values.
APP_BASE_URL=http://localhost:3000
DATABASE_URL=postgresql://refunddesk_web_login:refunddesk_web_local@127.0.0.1:5432/refunddesk
STRIPE_APP_ID=replace_me
STRIPE_PLATFORM_TEST_ACCOUNT_ID=acct_ReplacePlatformTest123
STRIPE_MANAGED_SANDBOX_ACCOUNT_ID=acct_ReplaceManagedSandbox456
STRIPE_PLATFORM_TEST_READ_KEY=replace_me
STRIPE_MANAGED_SANDBOX_READ_KEY=replace_me
STRIPE_ACCOUNT_TEST_WEBHOOK_SECRET=replace_me
STRIPE_ACCOUNT_SANDBOX_WEBHOOK_SECRET=replace_me
STRIPE_ACCOUNT_LIVE_WEBHOOK_SECRET=disabled
REFUNDDESK_FIELD_ENCRYPTION_KEY_V1=replace_with_base64_32_bytes
REFUNDDESK_EXPORT_SIGNING_KEY_V1=replace_with_distinct_base64_32_bytes
REFUNDDESK_ACTIVE_FIELD_KEY_VERSION=v1
REFUNDDESK_SIGNED_REQUEST_VERIFIER_URL=http://127.0.0.1:3101/internal/v1/signed-requests/verify

# Worker process. Effect keys are distinct from the read-only platform keys.
WORKER_DATABASE_URL=postgresql://refunddesk_worker_login:refunddesk_worker_local@127.0.0.1:5432/refunddesk
PGBOSS_DATABASE_URL=postgresql://refunddesk_queue_login:refunddesk_queue_local@127.0.0.1:5432/refunddesk
STRIPE_APP_SIGNING_SECRET=replace_me
STRIPE_PLATFORM_TEST_EFFECT_KEY=replace_me
STRIPE_MANAGED_SANDBOX_EFFECT_KEY=replace_me
REFUNDDESK_PROOF_HMAC_KEY_V1=replace_with_distinct_base64_32_bytes
REFUNDDESK_ACTIVE_PROOF_KEY_VERSION=v1
REFUNDDESK_APPROVAL_ATTESTATION_HMAC_KEY_V1=replace_with_another_distinct_base64_32_bytes
REFUNDDESK_ACTIVE_APPROVAL_ATTESTATION_KEY_VERSION=v1
WORKER_HEALTH_HOST=127.0.0.1
WORKER_HEALTH_PORT=3101

# Serialized one-shot migration job; never inject this owner URL into web or worker.
DATABASE_MIGRATION_URL=postgresql://refunddesk_owner:refunddesk_owner_local@127.0.0.1:5432/refunddesk
