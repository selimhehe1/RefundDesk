    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "stripe": "22.3.2"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
