{
  "name": "@refunddesk/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/apps/worker/src/index.d.ts",
      "default": "./dist/apps/worker/src/index.js"
    }
  },
  "scripts": {
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "pnpm build && node --watch --enable-source-maps dist/apps/worker/src/main.js",
    "start": "node --enable-source-maps dist/apps/worker/src/main.js",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@refunddesk/config": "workspace:*",
    "@refunddesk/contracts": "workspace:*",
    "@refunddesk/db": "workspace:*",
    "@refunddesk/domain": "workspace:*",
    "@refunddesk/observability": "workspace:*",
    "@refunddesk/stripe-adapter": "workspace:*",
    "pg-boss": "12.26.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "stripe": "22.3.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
